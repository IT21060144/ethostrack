# Copy this file to backend/.env and change the secrets.
PORT=5001
NODE_ENV=development

# Local MongoDB (or a MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/ethostrack

# Allowed browser origin(s) for the React app, comma-separated
CORS_ORIGIN=http://localhost:3000

# Long random strings, e.g. from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep PSEUDONYM_SECRET stable: changing it breaks every identity-to-pseudoId link in PseudonymMap.
JWT_SECRET=change-me
PSEUDONYM_SECRET=change-me-too

# Fallback scoring thresholds when a student has not set goals
DEFAULT_TARGET_DAYS=4
DEFAULT_MIN_MINUTES=30

# Heartbeat tracking (seconds)
HEARTBEAT_INTERVAL_SECONDS=30
SESSION_TIMEOUT_SECONDS=300

# Close a session after this many seconds of only idle heartbeats
IDLE_END_SECONDS=600

# Privacy service for /api/research (researcher accounts only)
# Every released group holds at least PRIVACY_K students; PRIVACY_EPSILON is
# the differential privacy budget per request (smaller = more noise).
PRIVACY_K=5
PRIVACY_EPSILON=1
RESEARCH_TIME_ZONE=Asia/Colombo
